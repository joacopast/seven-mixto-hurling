# ---- Base de datos ----
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seven_mixto?schema=public"
# Usada solo por `prisma migrate`/`db pull`. En local, igual a DATABASE_URL.
# En producción (Neon): la conexión directa (sin pooler), DATABASE_URL lleva el pooler.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/seven_mixto?schema=public"

# ---- Auth.js ----
# openssl rand -base64 32
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"
# Emails con rol ADMIN (separados por coma). El resto de usuarios son TEAM_MANAGER.
ADMIN_EMAILS="admin@sevenmixto.test"

# ---- Acceso staff a /admin (usuario y contraseña fijos, sin email) ----
STAFF_USERNAME="admin"
# Hash bcrypt recomendado en producción: npm run hash:password -- "tu-contraseña"
STAFF_PASSWORD_HASH=""
# Alternativa en texto plano, SOLO para desarrollo local
STAFF_PASSWORD=""
# Email del usuario ADMIN al que se asocia el login de staff (default: el primero de ADMIN_EMAILS)
STAFF_ADMIN_EMAIL=""
# Horas de validez de la sesión de staff (default 168 = 7 días)
STAFF_SESSION_HOURS="168"
# Sin STAFF_USERNAME/STAFF_PASSWORD configurados, en desarrollo el login cae a
# admin / admin. En producción queda cerrado hasta configurarlos.

# ---- Email (Resend) ----
RESEND_API_KEY=""
EMAIL_FROM="Seven Mixto Hurling <no-reply@sevenmixto.test>"

# ---- Mercado Pago (Fase 2) ----
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""
MP_BACK_URL_SUCCESS="http://localhost:3000/inscripcion/retorno?status=success"
MP_BACK_URL_FAILURE="http://localhost:3000/inscripcion/retorno?status=failure"
MP_BACK_URL_PENDING="http://localhost:3000/inscripcion/retorno?status=pending"

# ---- App ----
APP_URL="http://localhost:3000"

# ---- Rate limiting (Upstash Redis). Vacío = limiter no-op en dev ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Storage de escudos (Vercel Blob, Fase 5) ----
BLOB_READ_WRITE_TOKEN=""

# ---- Cron ----
CRON_SECRET="change-me"
